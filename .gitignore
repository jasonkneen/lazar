# ─── compiled / installed artifacts ─────────────────────────────────
src/target/
bin/lazar
bin/lazartui
# installed by setup.sh from scripts/lazar-spawn.sh (the tracked source)
bin/lazar-spawn
# installed by setup.sh from scripts/lazar-failover.sh (the tracked source)
bin/lazar-failover

# Operator runtime. Never part of the published core.
# The names without a trailing slash also cover the compatibility symlinks.
/user/
/skills
/hooks
/memory
/workspace
/logs

# ─── runtime state (per-user, generated by lazar at runtime) ────────
# These directories live alongside src/ inside ~/lazar/ but are
# NEVER part of the published repo. They're populated by `--reset-all`
# from src/seed-skills/ and src/seed-hooks/, then evolve as the user
# runs the agent.
/.archive/

# Local agent-client settings. Not part of the published tree.
.grok/

# ─── editor / IDE ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS cruft ───────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# ─── secrets / local env ────────────────────────────────────────────
.env
.env.local
*.local
# Operator-owned persisted sandbox mode (written by lazar-guardrails.sh)
/.guardrails
# Runtime state (operator-specific paths; deleted by --reset-all)
access-policy.json
# Operator provider catalog (seeded from src/providers.toml by setup.sh)
/providers.toml

# Note on Cargo.lock:
# We DO commit src/Cargo.lock — lazar is a binary, not a library, and
# locking dependency versions makes reproducible builds across machines.
/.claude/worktrees

# ─── generated docs ─────────────────────────────────────────────────
# `mkdocs build` output (docs/.venv is the local toolchain). Source of truth
# is docs/docs/ + docs/mkdocs.yml; rebuild rather than commit the output.
docs/site/
docs/.venv/
tui/target/
